# ---------- market data ----------
# yahoo | alphavantage | synthetic (offline, deterministic - good for demos and tests)
PRICE_PROVIDER=yahoo
ALPHAVANTAGE_API_KEY=
TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,JNJ,XOM,WMT

# ---------- simulated order source ----------
ORDERS_PER_DAY=500
CUSTOMER_COUNT=400
RANDOM_SEED=42

# ---------- data lake ----------
# local  -> writes Parquet under LOCAL_LAKE_DIR (no AWS needed)
# s3     -> writes Parquet to S3_BUCKET/S3_PREFIX
LOAD_TARGET=local
LOCAL_LAKE_DIR=./data/lake
S3_BUCKET=
S3_PREFIX=raw
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or mount ~/.aws, or use an instance/task role
# AWS_ENDPOINT_URL=http://localstack:4566   # uncomment to use LocalStack

# ---------- snowflake (only used when LOAD_TARGET=s3) ----------
LOAD_SNOWFLAKE=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=FIN_ETL_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=FIN_ETL_ROLE
SNOWFLAKE_WAREHOUSE=FIN_ETL_WH
SNOWFLAKE_DATABASE=FIN_SCRAPER

# ---------- prefect ----------
# PREFECT_API_URL=http://localhost:4200/api
